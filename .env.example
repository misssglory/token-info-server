# Copy to .env for local development; never commit credentials.
SOLANA_RPC=https://api.mainnet-beta.solana.com
ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
BSC_RPC=https://bsc-rpc.publicnode.com
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
HOST=127.0.0.1
PORT=9002
LOG_LEVEL=warn
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=token_cache
DB_USER=postgres
DB_PASSWORD=
DB_MAX_CONNECTIONS=10
CACHE_TTL_SECONDS=86400
TCP_ENDPOINT_ENABLED=false
TCP_ENDPOINT_HOST=127.0.0.1
TCP_ENDPOINT_PORT=9003
TCP_FORWARD_TOKENS=false
